-- minimize
local minimized = false
minimizeBtn.MouseButton1Click:Connect(function()
	minimized = not minimized
	frame.Size = minimized and UDim2.new(0, 582, 0, 20) or UDim2.new(0, 582, 0, 332)
	scrollFrame.Visible = not minimized
end)

-- hide and rebind
local guiVisible = true
local hideKey = Enum.KeyCode.RightShift
local listening = false

keybindBtn.MouseButton1Click:Connect(function()
	listening = true
	keybindLabel.Text = "Hide GUI Key: [Press any key...]"
	keybindBtn.Text = "Waiting..."
end)

UIS.InputBegan:Connect(function(input)
	if listening and input.UserInputType == Enum.UserInputType.Keyboard then
		hideKey = input.KeyCode
		keybindLabel.Text = "Hide GUI Key: " .. input.KeyCode.Name
		keybindBtn.Text = "Change Keybind"
		listening = false
		return
	end
	if input.KeyCode == hideKey then
		guiVisible = not guiVisible
		frame.Visible = guiVisible
	end
end)

-- dragging
local dragging, dragInput, dragStart, startPos = false, nil, nil, nil

topBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging, dragStart, startPos = true, input.Position, frame.Position
		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then dragging = false end
		end)
	end
end)

topBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then dragInput = input end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		local d = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
	end
end)